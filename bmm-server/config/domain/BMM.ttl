bmm:EnforcementLevel-OverrideWithExplanation
  a bmm:EnforcementLevel ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Override With Explanation" ;
  rdfs:comment "The \"Override With Explanation\" value of the EnforcementLevel enumeration." .

# ============================================================
# End Relationships
#
# Forward directions only. Inverse URIs (e.g., bmm:amplifies,
# bmm:makesOperative, bmm:quantifies) are identifiers referenced by
# ResourceShape inverse metadata but are never asserted as triples,
# so they are not declared here.
#
# Per OSLC convention, properties carry no rdfs:domain or rdfs:range;
# the domain and range constraints for this server's API live in the
# ResourceShapes (BMM-Shapes.ttl).
# ============================================================

# Vision → Goal
bmm:amplifiedBy
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "amplified by" ;
  rdfs:comment "A Goal that amplifies this Vision into more specific desired results." .

# Vision → Mission
bmm:madeOperativeBy
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "made operative by" ;
  rdfs:comment "The Mission that makes this Vision operative — indicates what must be done to make the Vision a reality." .

# Goal → Objective
bmm:quantifiedBy
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "quantified by" ;
  rdfs:comment "An Objective that quantifies this Goal by defining a specific, measurable target." .

# Goal → Goal (part-whole)
bmm:includesGoal
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "includes goal" ;
  rdfs:comment "A sub-Goal that is part of this Goal." .

# Objective → Objective (part-whole)
bmm:includesObjective
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "includes objective" ;
  rdfs:comment "A sub-Objective that is part of this Objective." .

# ============================================================
# Means Relationships
# ============================================================

# CourseOfAction → End
bmm:enablesEnd
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "enables end" ;
  rdfs:comment "An End that this CourseOfAction enables or contributes to achieving." .

# Strategy → End (Vision or Goal)
bmm:channelsEffortsToward
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "channels efforts toward" ;
  rdfs:comment "An End (Vision or Goal) toward which this Strategy channels efforts." .

# Strategy → Strategy (part-whole)
bmm:includesStrategy
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "includes strategy" ;
  rdfs:comment "A sub-Strategy that is a component of this Strategy." .

# Tactic → Strategy
bmm:implements
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "implements" ;
  rdfs:comment "The Strategy that this Tactic implements." .

# Tactic → Tactic (part-whole)
bmm:includesTactic
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "includes tactic" ;
  rdfs:comment "A sub-Tactic that is a component of this Tactic." .

# Directive → CourseOfAction
bmm:governs
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "governs" ;
  rdfs:comment "A CourseOfAction that is governed by this Directive." .

# BusinessRule → BusinessPolicy
bmm:basedOn
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "based on" ;
  rdfs:comment "The BusinessPolicy that this BusinessRule is based on." .

# BusinessPolicy → BusinessProcess
bmm:governsProcess
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "governs process" ;
  rdfs:comment "A BusinessProcess that is governed by this BusinessPolicy." .

# BusinessRule → BusinessProcess
bmm:enforcedByBusinessProcess
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "enforced by business process" ;
  rdfs:comment "A BusinessProcess that enforces this BusinessRule." .

# Tactic → BusinessRule
bmm:effectsEnforcementOfBusinessRule
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "effects enforcement of business rule" ;
  rdfs:comment "A BusinessRule whose enforcement is effected by this Tactic." .

# ============================================================
# Influencer and Assessment Relationships
# ============================================================

# Assessment → Influencer
bmm:assesses
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "assesses" ;
  rdfs:comment "The Influencer that this Assessment is about." .

# Assessment → PotentialImpact
bmm:identifiesPotentialImpact
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "identifies potential impact" ;
  rdfs:comment "A PotentialImpact identified by this Assessment." .

# Assessment → End
bmm:affectsAchievementOfEnd
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "affects achievement of end" ;
  rdfs:comment "An End whose achievement is affected by this Assessment." .

# Assessment → Means
bmm:affectsEmploymentOfMeans
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "affects employment of means" ;
  rdfs:comment "A Means whose employment is affected by this Assessment." .

# Assessment category (enumeration: bmm:AssessmentCategory)
bmm:assessmentCategory
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "assessment category" ;
  rdfs:comment "The SWOT category of this Assessment: Strength, Weakness, Opportunity, or Threat." .

# PotentialImpact → Directive
bmm:providesImpetusFor
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "provides impetus for" ;
  rdfs:comment "A Directive for which this PotentialImpact provides impetus." .

# PotentialImpact → End
bmm:isRiskForEnd
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "is risk for end" ;
  rdfs:comment "An End for which this PotentialImpact represents a risk." .

# PotentialImpact → Means
bmm:isRiskForMeans
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "is risk for means" ;
  rdfs:comment "A Means for which this PotentialImpact represents a risk." .

# PotentialImpact → End
bmm:isRewardForEnd
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "is reward for end" ;
  rdfs:comment "An End for which this PotentialImpact represents a potential reward." .

# PotentialImpact → Means
bmm:isRewardForMeans
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "is reward for means" ;
  rdfs:comment "A Means for which this PotentialImpact represents a potential reward." .

# ============================================================
# OrganizationUnit Relationships
# ============================================================

bmm:isResponsibleFor
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "is responsible for" ;
  rdfs:comment "An End that this OrganizationUnit is responsible for achieving." .

bmm:establishes
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "establishes" ;
  rdfs:comment "A Means that this OrganizationUnit establishes or deploys." .

bmm:recognizes
  a rdf:Property ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "recognizes" ;
