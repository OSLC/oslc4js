@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix oslc_am: <http://open-services.net/ns/am#> .
@prefix bmm:     <http://www.omg.org/spec/BMM#> .
@prefix vann:        <http://purl.org/vocab/vann/> .

# Ontology declaration
<http://www.omg.org/spec/BMM>
  a owl:Ontology ;
  owl:imports <http://open-services.net/ns/am> ;
  dcterms:title "OMG Business Motivation Model Vocabulary" ;
  dcterms:description "RDF vocabulary for the OMG Business Motivation Model (BMM) 1.3 metamodel, adapted for OSLC. BMM provides a scheme for developing, communicating, and managing business plans in an organized manner." ;
  rdfs:label "OMG Business Motivation Model Vocabulary" ;
  vann:preferredNamespacePrefix "bmm" ;
  vann:preferredNamespaceUri "http://www.omg.org/spec/BMM#" ;
  dcterms:publisher <https://open-services.net/about/> ;
  dcterms:issued "2026-04-24"^^<http://www.w3.org/2001/XMLSchema#date> ;
  dcterms:license <http://www.apache.org/licenses/LICENSE-2.0> ;
  dcterms:source </Users/jamsden/Developer/OSLC/oslc4js/bmm-server/config/domain/BMM.ttl> ;
  dcterms:isPartOf </Users/jamsden/Developer/OSLC/oslc4js/bmm-server/config/domain/BMM.ttl> ;
  dcterms:hasVersion "WD" ;
  dcterms:dateCopyrighted  "2012-2022" .


# ============================================================
# Abstract / Mixin Classes
# ============================================================

bmm:MotivationalElement
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf oslc_am:Resource ;
  rdfs:label "Motivational Element" ;
  rdfs:comment "The root abstract superclass of all BMM elements. A motivational element is any element that can be part of a business motivation model." .

# ============================================================
# Ends — What the enterprise wishes to achieve
# ============================================================

bmm:End
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:MotivationalElement ;
  rdfs:label "End" ;
  rdfs:comment "Something the enterprise wishes to achieve. Ends describe the desired future state of the enterprise. Ends are of two kinds: Vision and DesiredResult." .

bmm:Vision
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:End ;
  rdfs:label "Vision" ;
  rdfs:comment "An overall image of what the enterprise wants to be or become. A Vision is the ultimate, possibly unachievable, state the enterprise would like to attain. It describes the future in terms of what the enterprise wants to be rather than what it does." .

bmm:DesiredResult
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:End ;
  rdfs:label "Desired Result" ;
  rdfs:comment "An End that is a desired state or target the enterprise intends to maintain or sustain. DesiredResult is a superclass for Goal and Objective." .

bmm:Goal
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:DesiredResult ;
  rdfs:label "Goal" ;
  rdfs:comment "A statement about a state or condition of the enterprise to be brought about or sustained through appropriate Means. A Goal is a long-term, ongoing, qualitative statement of intent. A Goal amplifies a Vision — that is, it indicates what must be done to make the Vision a reality." .

bmm:Objective
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:DesiredResult ;
  rdfs:label "Objective" ;
  rdfs:comment "A statement of an attainable, time-targeted, and measurable target that the enterprise seeks to meet in order to achieve its Goals. An Objective quantifies a Goal — it makes the Goal measurable by defining specific, achievable targets with deadlines." .

# ============================================================
# Means — How the enterprise intends to achieve its Ends
# ============================================================

bmm:Means
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:MotivationalElement ;
  rdfs:label "Means" ;
  rdfs:comment "Any device, capability, regime, technique, restriction, agency, instrument, or method that may be called upon, activated, or enforced to achieve Ends. Means are of three kinds: Mission, CourseOfAction, and Directive." .

bmm:Mission
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:Means ;
  rdfs:label "Mission" ;
  rdfs:comment "The ongoing operational activity of the enterprise that makes the Vision operative. A Mission describes what the enterprise does day-to-day to pursue its Vision. A Mission makes a Vision operative." .

bmm:CourseOfAction
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:Means ;
  rdfs:label "Course of Action" ;
  rdfs:comment "An approach or plan for configuring some aspect of the enterprise involving things, processes, locations, people, timing, or motivation, undertaken to achieve Ends. CourseOfAction is a superclass for Strategy and Tactic." .

bmm:Strategy
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:CourseOfAction ;
  rdfs:label "Strategy" ;
  rdfs:comment "A CourseOfAction that represents a longer-term, broader approach to achieving Ends. A Strategy defines the essential courses the enterprise needs to pursue over time. A Strategy typically channels efforts toward Goals." .

bmm:Tactic
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:CourseOfAction ;
  rdfs:label "Tactic" ;
  rdfs:comment "A CourseOfAction that represents a shorter-term, more specific approach to achieving Ends. A Tactic implements a Strategy. A Tactic is narrowly focused and has a shorter time horizon than a Strategy." .

bmm:Directive
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:Means ;
  rdfs:label "Directive" ;
  rdfs:comment "A Means that governs CourseOfActions. A Directive provides the basis for guidance and constraints on the enterprise. Directive is a superclass for BusinessPolicy and BusinessRule." .

bmm:BusinessPolicy
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:Directive ;
  rdfs:label "Business Policy" ;
  rdfs:comment "A Directive that is not directly actionable. A BusinessPolicy exists to govern, guide, or constrain the enterprise and its activities. A BusinessPolicy provides the basis for BusinessRules." .

bmm:BusinessRule
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:Directive ;
  rdfs:label "Business Rule" ;
  rdfs:comment "A Directive that is a specific, actionable, testable constraint or guidance that is under business jurisdiction. A BusinessRule provides specific operational guidance that can be directly enforced." .

# ============================================================
# Influencers — Things that can affect Means and Ends
# ============================================================

bmm:Influencer
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:MotivationalElement ;
  rdfs:label "Influencer" ;
  rdfs:comment "Something that can cause changes affecting the enterprise in its employment of its Means or achievement of its Ends. An Influencer is an act, event, or state that is not under the control of the enterprise but has or may have an influence on business motivation elements." .

bmm:ExternalInfluencer
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:Influencer ;
  rdfs:label "External Influencer" ;
  rdfs:comment "An Influencer that comes from outside the enterprise. Examples include competitors, technology trends, regulations, economic conditions, and market changes." .

bmm:InternalInfluencer
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:Influencer ;
  rdfs:label "Internal Influencer" ;
  rdfs:comment "An Influencer that comes from inside the enterprise. Examples include resources, habits, infrastructure, management prerogatives, and corporate values." .

# ============================================================
# Assessment — Judgment about Influencers
# ============================================================

bmm:Assessment
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:MotivationalElement ;
  rdfs:label "Assessment" ;
  rdfs:comment "A judgment about an Influencer, specifically about its impact on the employment of specific Means or on the achievement of specific Ends. An Assessment uses the SWOT categories: Strength, Weakness, Opportunity, or Threat." .

bmm:PotentialImpact
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:MotivationalElement ;
  rdfs:label "Potential Impact" ;
  rdfs:comment "A possible effect that an Influencer may have on the enterprise, expressed as either a risk or a potential reward. A PotentialImpact is identified by an Assessment and can provide impetus for a Directive." .

# ============================================================
# Organization and Process
# ============================================================

bmm:OrganizationUnit
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:MotivationalElement ;
  rdfs:label "Organization Unit" ;
  rdfs:comment "An organized group of people that forms a recognized part of an organizational structure. An OrganizationUnit is responsible for achieving Ends, establishing and deploying Means, recognizing Influencers, and making Assessments." .

bmm:BusinessProcess
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:MotivationalElement ;
  rdfs:label "Business Process" ;
  rdfs:comment "A partially-ordered set of enterprise activities that can be executed to achieve some desired End or to realize a CourseOfAction. BusinessProcesses are governed by BusinessPolicies and BusinessRules." .

bmm:Asset
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:MotivationalElement ;
  rdfs:label "Asset" ;
  rdfs:comment "A resource of value owned or controlled by the enterprise. Assets are deployed to support CoursesOfAction and may be affected by Directives." .

bmm:InfluencingOrganization
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:ExternalInfluencer ;
  rdfs:label "Influencing Organization" ;
  rdfs:comment "An organization outside the enterprise that acts as an Influencer, such as a competitor, partner, regulator, or industry body." .

bmm:Regulation
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:subClassOf bmm:ExternalInfluencer ;
  rdfs:label "Regulation" ;
  rdfs:comment "A rule or directive made and maintained by an authority external to the enterprise, such as a government agency or standards body." .

# ============================================================
# Enumeration Types
#
# Each enumeration is a plain rdfs:Class whose instances are the
# allowed values (individuals with rdfs:label). Resource shapes
# reference the enumeration via oslc:range; they omit oslc:valueType
# and oslc:allowedValue unless a shape restricts to a subset of the
# values. See the OSLC Core vocabulary "Enumerations" section.
# ============================================================

bmm:AssessmentCategory
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Assessment Category" ;
  rdfs:comment "The SWOT category of an Assessment: Strength, Weakness, Opportunity, or Threat." .

bmm:AssessmentCategory-Strength
  a bmm:AssessmentCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Strength" ;
  rdfs:comment "The \"Strength\" value of the AssessmentCategory enumeration." .

bmm:AssessmentCategory-Weakness
  a bmm:AssessmentCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Weakness" ;
  rdfs:comment "The \"Weakness\" value of the AssessmentCategory enumeration." .

bmm:AssessmentCategory-Opportunity
  a bmm:AssessmentCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Opportunity" ;
  rdfs:comment "The \"Opportunity\" value of the AssessmentCategory enumeration." .

bmm:AssessmentCategory-Threat
  a bmm:AssessmentCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Threat" ;
  rdfs:comment "The \"Threat\" value of the AssessmentCategory enumeration." .

bmm:InfluencerCategory
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Influencer Category" ;
  rdfs:comment "The category of an Influencer, e.g. Competition, Customer, Environment, Habit, Infrastructure, Issue, Management Prerogative, Partner, Regulation, Resource, Supplier, or Technology. The set is open for extension." .

bmm:InfluencerCategory-Competition
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Competition" ;
  rdfs:comment "The \"Competition\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Customer
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Customer" ;
  rdfs:comment "The \"Customer\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Environment
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Environment" ;
  rdfs:comment "The \"Environment\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Habit
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Habit" ;
  rdfs:comment "The \"Habit\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Infrastructure
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Infrastructure" ;
  rdfs:comment "The \"Infrastructure\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Issue
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Issue" ;
  rdfs:comment "The \"Issue\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-ManagementPrerogative
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Management Prerogative" ;
  rdfs:comment "The \"Management Prerogative\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Partner
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Partner" ;
  rdfs:comment "The \"Partner\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Regulation
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Regulation (category)" ;
  rdfs:comment "The \"Regulation\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Resource
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Resource" ;
  rdfs:comment "The \"Resource\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Supplier
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Supplier" ;
  rdfs:comment "The \"Supplier\" value of the InfluencerCategory enumeration." .

bmm:InfluencerCategory-Technology
  a bmm:InfluencerCategory ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
  rdfs:label "Technology" ;
  rdfs:comment "The \"Technology\" value of the InfluencerCategory enumeration." .

bmm:EnforcementLevel
  a rdfs:Class ;
  rdfs:isDefinedBy <http://www.omg.org/spec/BMM> ;
